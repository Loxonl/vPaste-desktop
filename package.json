{
  "name": "vpaste-desktop",
  "private": true,
  "version": "1.6.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Loxonl/vPaste-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Loxonl/vPaste-desktop/issues"
  },
  "homepage": "https://github.com/Loxonl/vPaste-desktop#readme",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "powershell -ExecutionPolicy Bypass -File ./scripts/run-dev-app.ps1",
    "dev:debug": "node ./scripts/run-dev-debug.mjs",
    "build": "tsc && vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows-release.ps1",
    "build:windows:signed-updater": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows-release.ps1 -SignUpdater",
    "build:macos": "tauri build --bundles dmg --config src-tauri/tauri.local.conf.json",
    "build:macos-release": "bash ./scripts/build-macos-release.sh",
    "benchmark:ui": "playwright test --config playwright.benchmark.config.ts",
    "check:licenses": "node scripts/check-third-party-licenses.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "check:styles": "node scripts/check-ui-style-architecture.mjs",
    "check:ui": "npm run check:styles && npm run build && npm run test:unit && npm run test:visual",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "tauri": "tauri"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.12",
    "@mui/material": "^5.15.12",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "material-icon-theme": "5.37.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
