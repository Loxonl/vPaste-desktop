{
  "build": {
    "beforeDevCommand": "node ./scripts/start-vite-dev.mjs",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0",
      "files": {
        "Library/LaunchAgents/com.loxonl.vpaste.background.plist": "macos/LaunchAgents/com.loxonl.vpaste.background.plist"
      }
    }
  },
  "productName": "vPaste",
  "mainBinaryName": "vPaste",
  "version": "1.6.0",
  "identifier": "com.loxonl.vpaste",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMkZBOTA5ODEwMURDMkQKUldRdDNBR0JDYWt2aTl5bG5ON2t4cjJZTkJuUFpkWmwwY2ZhUXBCNWpnSjU4TkxXVWdtTGE4bVUK",
      "endpoints": [
        "https://github.com/Loxonl/vPaste-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "clipboardPreview",
        "url": "/clipboard/preview",
        "fullscreen": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "titleBarStyle": "Overlay",
        "height": 500,
        "width": 500
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https: http:",
        "frame-src": "https: http: asset:",
        "font-src": [
          "https://fonts.gstatic.com"
        ],
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http:",
        "style-src": "'unsafe-inline' 'self' https: http:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420"
      }
    }
  }
}
